# EQ-Bench 3 Integration Configuration
# Konfiguracja integracji Dashboard Kalibracyjny z EQ-Bench 3

# API Endpoints
MIGI_ENDPOINT=http://localhost:5000/api/v1/respond
TELEMETRY_ENDPOINT=http://localhost:8765
DASHBOARD_URL=http://localhost:8080

# EQ-Bench Configuration
EQBENCH_RESULTS_DIR=./eqbench_results
EQBENCH_JUDGE_MODEL=claude-3-sonnet
EQBENCH_TEST_MODEL=migi_adapter

# OpenAI API (for judge model - optional)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API (for Claude judge - recommended)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Snapshot Configuration
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL=10
SNAPSHOT_DIR=./snapshots

# Experiment Configuration
EXPERIMENT_TIMEOUT=60
MAX_SCENARIOS_PER_RUN=20
ENABLE_LIVE_MONITORING=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/eqbench_integration.log

# Dashboard Integration
DASHBOARD_SNAPSHOT_URL=http://localhost:8765/snapshot
DASHBOARD_METRICS_URL=http://localhost:8765/metrics
REALTIME_UPDATES=true

# Performance Tuning
ASYNC_PROCESSING=true
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30

# Report Generation
GENERATE_HTML_REPORTS=true
REPORT_OUTPUT_DIR=./reports
INCLUDE_PSYCHE_ANALYSIS=true